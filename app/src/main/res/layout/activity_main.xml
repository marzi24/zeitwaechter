<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/primary_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Erinnert dich rechtzeitig vor der Höchstarbeitszeit ans Ausstempeln."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- ============ HEUTE ============ -->
        <LinearLayout style="@style/Section">

            <TextView
                style="@style/SectionTitle"
                android:text="Heute" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRemaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWorked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Startzeit mit der Stempeluhr abgleichen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMinus"
                    style="@style/Btn"
                    android:layout_weight="0.7"
                    android:layout_marginEnd="6dp"
                    android:text="−1 Min" />

                <Button
                    android:id="@+id/btnEditStart"
                    style="@style/Btn"
                    android:layout_weight="1.6"
                    android:backgroundTint="@color/primary"
                    android:textColor="#FFFFFF"
                    android:text="Startzeit festlegen" />

                <Button
                    android:id="@+id/btnPlus"
                    style="@style/Btn"
                    android:layout_weight="0.7"
                    android:layout_marginStart="6dp"
                    android:text="+1 Min" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStart"
                    style="@style/Btn"
                    android:layout_marginEnd="6dp"
                    android:text="Jetzt eingestempelt" />

                <Button
                    android:id="@+id/btnEnd"
                    style="@style/Btn"
                    android:layout_marginStart="6dp"
                    android:text="Ausgestempelt" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDiscard"
                style="@style/BtnWide"
                android:layout_marginTop="0dp"
                android:text="Verwerfen (kein Arbeitstag)" />
        </LinearLayout>

        <!-- ============ BERECHTIGUNGEN ============ -->
        <LinearLayout style="@style/Section">

            <TextView
                style="@style/SectionTitle"
                android:text="Einrichtung (einmalig)" />

            <TextView
                android:id="@+id/tvPerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnPermLocation"
                style="@style/BtnWide"
                android:text="1. Standort &amp; Benachrichtigungen erlauben" />

            <Button
                android:id="@+id/btnPermBackground"
                style="@style/BtnWide"
                android:text="2. Standort „Immer zulassen“" />

            <Button
                android:id="@+id/btnPermBattery"
                style="@style/BtnWide"
                android:text="3. Akku-Optimierung &amp; Wecker" />
        </LinearLayout>

        <!-- ============ ARBEITSORT ============ -->
        <LinearLayout style="@style/Section">

            <TextView
                style="@style/SectionTitle"
                android:text="Arbeitsort" />

            <TextView
                android:id="@+id/tvGeofence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnUseCurrent"
                style="@style/BtnWide"
                android:text="Aktuellen Standort als Arbeitsort speichern" />

            <Button
                android:id="@+id/btnPasteLocation"
                style="@style/BtnWide"
                android:text="📋 Aus Zwischenablage einfügen (Google Maps)" />

            <TextView
                style="@style/Label"
                android:text="Breitengrad (oder „48.49, 9.21“ einfügen)" />

            <EditText
                android:id="@+id/etLat"
                style="@style/Field"
                android:hint="z. B. 48.491234"
                android:imeOptions="actionNext"
                android:inputType="text" />

            <TextView
                style="@style/Label"
                android:text="Längengrad" />

            <EditText
                android:id="@+id/etLon"
                style="@style/Field"
                android:hint="z. B. 9.204321"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal|numberSigned" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOpenMap"
                    style="@style/Btn"
                    android:layout_marginEnd="6dp"
                    android:text="In Karte prüfen" />

                <Button
                    android:id="@+id/btnSaveLocation"
                    style="@style/Btn"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/primary"
                    android:textColor="#FFFFFF"
                    android:text="✔ Arbeitsort übernehmen" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ EINSTELLUNGEN ============ -->
        <LinearLayout style="@style/Section">

            <TextView
                style="@style/SectionTitle"
                android:text="Einstellungen" />

            <Switch
                android:id="@+id/swEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Automatisch erkennen (Kommen &amp; Gehen)"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                style="@style/Label"
                android:text="Radius um den Arbeitsort (Meter, 100–300 empfohlen)" />

            <EditText
                android:id="@+id/etRadius"
                style="@style/Field"
                android:inputType="number" />

            <TextView
                style="@style/Label"
                android:text="Minuten vom Ankommen bis zur Stempeluhr" />

            <EditText
                android:id="@+id/etOffset"
                style="@style/Field"
                android:inputType="number" />

            <TextView
                style="@style/Label"
                android:text="Höchstarbeitszeit (Stunden, ohne Pause)" />

            <EditText
                android:id="@+id/etMaxHours"
                style="@style/Field"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/Label"
                android:text="Pause, die dazugerechnet wird (Minuten)" />

            <EditText
                android:id="@+id/etBreak"
                style="@style/Field"
                android:inputType="number" />

            <TextView
                style="@style/Label"
                android:text="Warnungen (Minuten vorher, mit Komma getrennt)" />

            <EditText
                android:id="@+id/etWarn"
                style="@style/Field"
                android:inputType="text" />

            <TextView
                style="@style/Label"
                android:text="Kurz weg? Sitzung fortsetzen, wenn zurück innerhalb von (Minuten)" />

            <EditText
                android:id="@+id/etResume"
                style="@style/Field"
                android:inputType="number" />

            <Button
                android:id="@+id/btnSave"
                style="@style/BtnWide"
                android:backgroundTint="@color/primary"
                android:text="Speichern"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- ============ VERLAUF ============ -->
        <LinearLayout style="@style/Section">

            <TextView
                style="@style/SectionTitle"
                android:text="Verlauf (geschätzte Zeiten)" />

            <TextView
                android:id="@+id/tvHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnExport"
                style="@style/BtnWide"
                android:text="Verlauf als CSV teilen" />

            <Button
                android:id="@+id/btnEditLast"
                style="@style/BtnWide"
                android:text="Letzten Eintrag bearbeiten (Beginn / Ende)" />

            <Button
                android:id="@+id/btnDeleteLast"
                style="@style/BtnWide"
                android:text="Letzten Eintrag löschen" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Hinweis: Die App ist nur eine Erinnerungshilfe. Maßgeblich ist immer die Zeit an der Stempeluhr. Alle Daten bleiben auf diesem Handy."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
