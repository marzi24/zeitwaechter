<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ============ KOPF ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/primary_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:contentDescription="Einstellungen"
            android:focusable="true"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/text"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- Reiter -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/section_bg"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabHeute"
            style="@style/Tab"
            android:text="Heute" />

        <TextView
            android:id="@+id/tabZeit"
            style="@style/Tab"
            android:text="Arbeitszeit" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollHeute"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tvSetupHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/warn_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:text="⚠ Einrichtung noch nicht vollständig – hier tippen, um sie in den Einstellungen abzuschließen."
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- ============ HEUTE ============ -->
                <LinearLayout style="@style/Section">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="Heute" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvDeadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRemaining"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWorked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <!-- Startzeit mit der Stempeluhr abgleichen -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnMinus"
                            style="@style/Btn"
                            android:layout_weight="0.7"
                            android:layout_marginEnd="6dp"
                            android:text="−1 Min" />

                        <Button
                            android:id="@+id/btnEditStart"
                            style="@style/Btn"
                            android:layout_weight="1.6"
                            android:backgroundTint="@color/primary"
                            android:textColor="#FFFFFF"
                            android:text="Startzeit festlegen" />

                        <Button
                            android:id="@+id/btnPlus"
                            style="@style/Btn"
                            android:layout_weight="0.7"
                            android:layout_marginStart="6dp"
                            android:text="+1 Min" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnStart"
                            style="@style/Btn"
                            android:layout_marginEnd="6dp"
                            android:text="Jetzt eingestempelt" />

                        <Button
                            android:id="@+id/btnEnd"
                            style="@style/Btn"
                            android:layout_marginStart="6dp"
                            android:text="Ausgestempelt" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnDiscard"
                        style="@style/BtnWide"
                        android:layout_marginTop="0dp"
                        android:text="Verwerfen (kein Arbeitstag)" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:text="Hinweis: Die App ist nur eine Erinnerungshilfe. Maßgeblich ist immer die Zeit an der Stempeluhr. Alle Daten bleiben auf diesem Handy."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/scrollZeit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- ============ MONAT ============ -->
                <LinearLayout style="@style/Section">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPrevMonth"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="◀" />

                        <TextView
                            android:id="@+id/tvMonth"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="@color/text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnNextMonth"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="▶" />
                    </LinearLayout>

                    <TableLayout
                        android:id="@+id/tableMonth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:stretchColumns="1" />

                    <TextView
                        android:id="@+id/tvMonthSum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Zeile antippen zum Bearbeiten. Pause mit * = automatisch. Datum in Farbe = Sa/So, F = Feiertag."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnAddEntry"
                            style="@style/Btn"
                            android:layout_marginEnd="6dp"
                            android:text="+ Eintrag" />

                        <Button
                            android:id="@+id/btnAddFree"
                            style="@style/Btn"
                            android:layout_marginStart="6dp"
                            android:text="+ Freier Tag (Abbau)" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnExport"
                        style="@style/BtnWide"
                        android:text="Alle Einträge als CSV teilen" />
                </LinearLayout>

                <!-- ============ ÜBERSTUNDENKONTO ============ -->
                <LinearLayout style="@style/Section">

                    <TextView
                        android:id="@+id/tvAccTitle"
                        style="@style/SectionTitle"
                        android:text="Überstundenkonto" />

                    <TextView
                        android:id="@+id/tvBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBalanceInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvOtSplit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- ============ AUSZAHLUNG (groß) ============ -->
                <LinearLayout
                    style="@style/Section"
                    android:background="@drawable/payout_card"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/tvPayoutTitle"
                        style="@style/SectionTitle"
                        android:gravity="center"
                        android:textColor="@color/on_payout" />

                    <TextView
                        android:id="@+id/tvPayoutAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/on_payout"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPayoutDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/on_payout"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:text="Sollzeit gilt an Tagen Mo–Fr mit Eintrag. Tage ohne Eintrag (frei, Urlaub, krank) zählen nicht. Für einen Tag Überstundenabbau „+ Freier Tag“ eintragen. Beträge sind Schätzungen brutto vor Steuern und Abgaben."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/scrollSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- ============ BERECHTIGUNGEN ============ -->
                <LinearLayout style="@style/Section">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="Einrichtung (einmalig)" />

                    <TextView
                        android:id="@+id/tvPerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnPermLocation"
                        style="@style/BtnWide"
                        android:text="1. Standort &amp; Benachrichtigungen erlauben" />

                    <Button
                        android:id="@+id/btnPermBackground"
                        style="@style/BtnWide"
                        android:text="2. Standort „Immer zulassen“" />

                    <Button
                        android:id="@+id/btnPermBattery"
                        style="@style/BtnWide"
                        android:text="3. Akku-Optimierung &amp; Wecker" />
                </LinearLayout>

                <!-- ============ ARBEITSORT ============ -->
                <LinearLayout style="@style/Section">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="Arbeitsort" />

                    <TextView
                        android:id="@+id/tvGeofence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnUseCurrent"
                        style="@style/BtnWide"
                        android:text="Aktuellen Standort als Arbeitsort speichern" />

                    <Button
                        android:id="@+id/btnPasteLocation"
                        style="@style/BtnWide"
                        android:text="📋 Aus Zwischenablage einfügen (Google Maps)" />

                    <TextView
                        style="@style/Label"
                        android:text="Breitengrad (oder „48.49, 9.21“ einfügen)" />

                    <EditText
                        android:id="@+id/etLat"
                        style="@style/Field"
                        android:hint="z. B. 48.491234"
                        android:imeOptions="actionNext"
                        android:inputType="text" />

                    <TextView
                        style="@style/Label"
                        android:text="Längengrad" />

                    <EditText
                        android:id="@+id/etLon"
                        style="@style/Field"
                        android:hint="z. B. 9.204321"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal|numberSigned" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnOpenMap"
                            style="@style/Btn"
                            android:layout_marginEnd="6dp"
                            android:text="In Karte prüfen" />

                        <Button
                            android:id="@+id/btnSaveLocation"
                            style="@style/Btn"
                            android:layout_marginStart="6dp"
                            android:backgroundTint="@color/primary"
                            android:textColor="#FFFFFF"
                            android:text="✔ Arbeitsort übernehmen" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ ERKENNUNG ============ -->
                <LinearLayout style="@style/Section">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="Erkennung &amp; Erinnerungen" />

                    <Switch
                        android:id="@+id/swEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Automatisch erkennen (Kommen &amp; Gehen)"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Label"
                        android:text="Radius um den Arbeitsort (Meter, 100–300 empfohlen)" />

                    <EditText
                        android:id="@+id/etRadius"
                        style="@style/Field"
                        android:inputType="number" />

                    <TextView
                        style="@style/Label"
                        android:text="Morgens: Minuten vom Ankommen bis zum Einstempeln (Parken + Laufen)" />

                    <EditText
                        android:id="@+id/etOffset"
                        style="@style/Field"
                        android:inputType="number" />

                    <TextView
                        style="@style/Label"
                        android:text="Abends: Minuten vom Ausstempeln bis zum Wegfahren (Laufen zum Auto)" />

                    <EditText
                        android:id="@+id/etOffsetOut"
                        style="@style/Field"
                        android:inputType="number" />

                    <TextView
                        style="@style/Label"
                        android:text="Höchstarbeitszeit (Stunden, ohne Pause)" />

                    <EditText
                        android:id="@+id/etMaxHours"
                        style="@style/Field"
                        android:inputType="numberDecimal" />

                    <TextView
                        style="@style/Label"
                        android:text="Späteste Ausstempel-Uhrzeit (z. B. 20:45, leer = keine)" />

                    <EditText
                        android:id="@+id/etLatestOut"
                        style="@style/Field"
                        android:hint="20:45"
                        android:inputType="time" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Es gilt immer die frühere Grenze: 10 h + Pause oder diese Uhrzeit. Beginnt ein Dienst erst nach dieser Uhrzeit (Nachtdienst), gilt nur die 10-h-Grenze."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/Label"
                        android:text="Warnungen (Minuten vorher, mit Komma getrennt)" />

                    <EditText
                        android:id="@+id/etWarn"
                        style="@style/Field"
                        android:inputType="text" />

                    <TextView
                        style="@style/Label"
                        android:text="Kurz weg? Sitzung fortsetzen, wenn zurück innerhalb von (Minuten)" />

                    <EditText
                        android:id="@+id/etResume"
                        style="@style/Field"
                        android:inputType="number" />
                </LinearLayout>

                <!-- ============ ARBEITSZEIT & ÜBERSTUNDEN ============ -->
                <LinearLayout style="@style/Section">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="Arbeitszeit &amp; Überstunden" />

                    <TextView
                        style="@style/Label"
                        android:text="Sollarbeitszeit pro Tag Mo–Fr (Stunden, z. B. 38,5 h ÷ 5 = 7,7)" />

                    <EditText
                        android:id="@+id/etSoll"
                        style="@style/Field"
                        android:inputType="numberDecimal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Samstag, Sonntag und Feiertage haben keine Sollzeit – dort zählt jede Stunde als Überstunde."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/Label"
                        android:layout_marginTop="12dp"
                        android:text="Pause wird abgezogen ab Anwesenheit von (Stunden)" />

                    <EditText
                        android:id="@+id/etPauseAfter"
                        style="@style/Field"
                        android:inputType="numberDecimal" />

                    <TextView
                        style="@style/Label"
                        android:text="Pause höchstens (Minuten)" />

                    <EditText
                        android:id="@+id/etBreak"
                        style="@style/Field"
                        android:inputType="number" />

                    <TextView
                        android:id="@+id/tvPauseExample"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/Label"
                        android:text="Überstunden zum Start (Stunden, auch negativ, z. B. 35 oder -3)" />

                    <EditText
                        android:id="@+id/etStartBal"
                        style="@style/Field"
                        android:inputType="numberDecimal|numberSigned" />

                    <Button
                        android:id="@+id/btnStartDate"
                        style="@style/BtnWide" />

                    <TextView
                        style="@style/Label"
                        android:text="Auszahlung am Monatsende ab Kontostand (Stunden)" />

                    <EditText
                        android:id="@+id/etLimit"
                        style="@style/Field"
                        android:inputType="numberDecimal" />

                    <TextView
                        style="@style/Label"
                        android:text="Stundenlohn brutto (€)" />

                    <EditText
                        android:id="@+id/etRate"
                        style="@style/Field"
                        android:hint="z. B. 25,50"
                        android:inputType="numberDecimal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Am Monatsende wird alles über dem Kontostand ausgezahlt, der nächste Monat beginnt dann wieder mit diesem Wert."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- ============ ZUSCHLÄGE ============ -->
                <LinearLayout style="@style/Section">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="Zuschläge auf Überstunden" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Montag – Freitag"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/etSurWeek"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Samstag – erste Stunden"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/etSurSatLow"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="… so viele Stunden"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/etSatLowHours"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="h"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Samstag – danach"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/etSurSatHigh"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sonntag"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/etSurSun"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Feiertag"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <EditText
                            android:id="@+id/etSurHol"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:singleLine="true"
                            android:textColor="@color/text"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Werden mehr Stunden ausgezahlt, zählt jede Stunde anteilig mit dem Zuschlag, mit dem sie in diesem Monat entstanden ist. Ein Feiertag geht vor Sonntag und Samstag."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- ============ FEIERTAGE ============ -->
                <LinearLayout style="@style/Section">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="Feiertage" />

                    <TextView
                        style="@style/Label"
                        android:text="Bundesland" />

                    <Spinner
                        android:id="@+id/spState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <TextView
                        style="@style/Label"
                        android:text="Zusätzliche Feiertage (TT.MM, mit Komma, z. B. 24.12, 31.12)" />

                    <EditText
                        android:id="@+id/etExtraHol"
                        style="@style/Field"
                        android:hint="leer lassen, wenn keine"
                        android:inputType="text" />

                    <TextView
                        android:id="@+id/tvHolidayList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnSaveAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/primary"
                    android:text="Alle Einstellungen speichern"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</LinearLayout>
